<% content_for :title, "Courses · Vertical Institute" %>

<div class="mx-auto max-w-7xl space-y-6">
  <header>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Courses</h1>
    <p class="mt-1 text-sm text-slate-500">Each course's enrollment health at a glance.</p>
  </header>

  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% @courses.each do |course| %>
      <%
        counts     = course.enrollments.group_by(&:risk_level)
        low        = counts["low"]&.size.to_i
        medium     = counts["medium"]&.size.to_i
        high       = counts["high"]&.size.to_i
        total      = course.enrollments.size
        safe_total = total.zero? ? 1 : total
      %>
      <li>
        <%= link_to course_path(course), class: "block rounded-xl bg-white p-5 ring-1 ring-slate-200 shadow-sm transition hover:shadow-md hover:ring-indigo-200" do %>
          <div class="flex items-center justify-between">
            <div class="min-w-0">
              <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= course.code %></p>
              <h3 class="mt-1 truncate text-lg font-semibold text-slate-900"><%= course.name %></h3>
            </div>
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
              </svg>
            </span>
          </div>
          <p class="mt-3 text-sm text-slate-600"><%= course.total_lessons %> lessons · <%= course.total_assignments %> assignments</p>

          <div class="mt-4">
            <div class="flex h-2 overflow-hidden rounded-full bg-slate-100">
              <div class="h-full bg-emerald-400" style="width: <%= (low.to_f    / safe_total * 100).round %>%"></div>
              <div class="h-full bg-amber-400"   style="width: <%= (medium.to_f / safe_total * 100).round %>%"></div>
              <div class="h-full bg-rose-500"    style="width: <%= (high.to_f   / safe_total * 100).round %>%"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs text-slate-500">
              <span><%= total %> enrolled</span>
              <span class="font-medium text-slate-700"><%= medium + high %> at risk</span>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
