<%
  sublabel ||= nil
  icon     ||= :users
  tone     ||= "default"

  icon_paths = {
    users:   '<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>',
    warning: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>',
    alert:   '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>',
    trend:   '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"/>'
  }

  tone_class = {
    "default" => "text-slate-400",
    "rose"    => "text-rose-500",
    "amber"   => "text-amber-500",
    "emerald" => "text-emerald-500"
  }[tone.to_s] || "text-slate-400"
%>

<div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 shadow-sm">
  <div class="flex items-start justify-between">
    <p class="text-sm font-medium text-slate-600"><%= title %></p>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 <%= tone_class %>">
      <%= raw(icon_paths[icon] || icon_paths[:users]) %>
    </svg>
  </div>
  <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900"><%= value %></p>
  <% if sublabel %>
    <p class="mt-1 text-xs text-slate-500"><%= sublabel %></p>
  <% end %>
</div>
